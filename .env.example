# Server-side key (used by /api routes for Geocoding, Distance Matrix, Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Client-side key (used by @react-google-maps/api to render the map)
# You can use the same key as above, but restrict it by HTTP referrer in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Store / depot location used as the start point of every route.
NEXT_PUBLIC_BASE_LOCATION=Hellinga 3

# Region bias for the Geocoding API (ISO 3166-1 alpha-2, e.g. "NO" for Norway).
NEXT_PUBLIC_REGION=NO
